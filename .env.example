# Variables de entorno para RecuerdaMe
# Copia este archivo como .env y actualiza con tus valores

# Configuración Flask
FLASK_ENV=development
SECRET_KEY=tu-clave-secreta-muy-segura-cambiala-en-produccion

# Firebase Configuration
FIREBASE_PROJECT_ID=tu-proyecto-firebase
FIREBASE_API_KEY=tu-api-key-de-firebase
FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789012

# Google Maps API
GOOGLE_MAPS_API_KEY=tu-google-maps-api-key

# VAPID Keys para Push Notifications
VAPID_PUBLIC_KEY=tu-vapid-public-key
VAPID_PRIVATE_KEY=tu-vapid-private-key

# Base de datos (opcional para desarrollo local)
DATABASE_URL=sqlite:///recuerdame.db

# Configuración de correo (opcional)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=tu-email@gmail.com
MAIL_PASSWORD=tu-password-de-aplicacion

# Debug (solo desarrollo)
DEBUG=True
